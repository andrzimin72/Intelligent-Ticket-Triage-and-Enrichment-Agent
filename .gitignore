# =============================================================================
# TERRAFORM
# =============================================================================
# Local working directory
.terraform/

# State files (NEVER commit state files to Git)
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json

# Crash logs
crash.log

# Local override files (Safe to ignore, keeps local dev secrets out of Git)
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars.local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# NOTE: .terraform.lock.hcl SHOULD be committed to ensure reproducible builds.
# Do not add it to this file.

# =============================================================================
# PYTHON
# =============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / Black
.ruff_cache/

# =============================================================================
# BUILD ARTIFACTS (Lambda & Layers)
# =============================================================================
.build/
*.zip
layers/*/layer.zip
layers/*/package/

# =============================================================================
# DOCKER
# =============================================================================
.docker/
docker-compose.override.yml
*.log

# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================
# NEVER commit actual secrets
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
credentials
.aws/

# =============================================================================
# IDE & EDITORS
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================================================
# DOCUMENTATION & STATIC SITE BUILD
# =============================================================================
site/
docs/architecture/ieee1471/rendered/

# =============================================================================
# OS & MISC
# =============================================================================
# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Node modules (if any JS tooling is used for the portal)
node_modules/
package-lock.json
yarn.lock
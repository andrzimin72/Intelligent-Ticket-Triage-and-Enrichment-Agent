# =============================================================================
# MSP AI Platform - Development Environment
# =============================================================================
# Usage: terraform plan -var-file=terraform.tfvars.dev
# Deployed automatically on merge to main via GitHub Actions.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------
project     = "msp-triage"
environment = "dev"
aws_region  = "us-east-1"

# -----------------------------------------------------------------------------
# MICROSOFT INTEGRATION (Fill in your dev values)
# -----------------------------------------------------------------------------
entra_tenant_id      = "00000000-0000-0000-0000-000000000000"
entra_app_client_id  = "11111111-1111-1111-1111-111111111111"
agent_admin_group_id = "22222222-2222-2222-2222-222222222222"
bot_app_id           = "33333333-3333-3333-3333-333333333333"

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
alert_email                         = "dev-alerts@yourmsp.com"
metrics_report_sender_email         = "dev-reports@yourmsp.com"
metrics_report_recipient_email      = "dev-leadership@yourmsp.com"
customer_digest_sender_email        = "dev-digest@yourmsp.com"
customer_insights_sender_email      = "dev-insights@yourmsp.com"
password_reset_sender_email         = "dev-passwords@yourmsp.com"
agent_notification_sender_email     = "dev-notifications@yourmsp.com"
agent_security_notification_email   = "dev-security@yourmsp.com"
password_reset_support_email        = "dev-support@yourmsp.com"

# -----------------------------------------------------------------------------
# CUSTOM DOMAINS (leave empty to use AWS-generated URLs)
# -----------------------------------------------------------------------------
password_reset_domain_name = ""
portal_domain_name         = ""
password_reset_hosted_zone_id = ""
portal_hosted_zone_id         = ""

# -----------------------------------------------------------------------------
# FEATURE FLAGS (enable most features for testing)
# -----------------------------------------------------------------------------
enable_cost_optimization       = true
enable_knowledge_base          = true   # Test KB in dev
enable_onboarding_api          = true
enable_status_history          = true
enable_webhook_notifications   = true   # Test webhooks in dev
enable_custom_health_checks    = true   # Test rules in dev
enable_tenant_portal           = true   # Test portal in dev
enable_advanced_analytics      = true   # Test analytics in dev
enable_cloudwatch_dashboards   = true
enable_microsoft_teams_bot     = true
enable_password_reset          = true
enable_customer_digest         = true
enable_customer_insights       = true
enable_feedback_loop           = true
enable_xray_tracing            = true

# -----------------------------------------------------------------------------
# RETENTION (shorter in dev to save costs)
# -----------------------------------------------------------------------------
agent_audit_log_retention_days            = 30
metrics_retention_days                    = 7
feedback_retention_days                   = 30
agent_feedback_retention_days             = 30
customer_digest_history_retention_days    = 14
customer_insights_retention_days          = 90
status_history_retention_days             = 30
analytics_retention_days                  = 90

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
log_retention_days = 14

# -----------------------------------------------------------------------------
# PERFORMANCE (relaxed for dev)
# -----------------------------------------------------------------------------
lambda_timeout_seconds = 60
lambda_memory_mb       = 512
max_concurrency        = 2  # Lower concurrency in dev

# -----------------------------------------------------------------------------
# RATE LIMITS (relaxed for testing)
# -----------------------------------------------------------------------------
agent_self_rate_limits = {
  per_operation_hourly = 10
  per_operation_daily  = 50
  requests_hourly      = 50
}

agent_admin_rate_limits = {
  per_operation_hourly = 50
  per_operation_daily  = 200
  per_target_daily     = 10
  requests_hourly      = 100
}

status_api_requests_per_second          = 10
status_api_burst_limit                  = 20
status_deep_health_requests_per_second  = 5
status_deep_health_burst_limit          = 10

# -----------------------------------------------------------------------------
# SECURITY (relaxed in dev)
# -----------------------------------------------------------------------------
secret_recovery_window_days       = 0  # Immediate deletion in dev
password_reset_token_ttl_seconds  = 3600  # 1 hour in dev
deprovision_drain_seconds         = 10  # Short drain for testing

# -----------------------------------------------------------------------------
# TEST TENANTS
# -----------------------------------------------------------------------------
tenants = {
  "dev-test-alpha" = {
    display_name    = "Dev Test Alpha"
    entra_tenant_id = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
    admin_group_id  = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"
    agent_instruction = "You are a test agent for Dev Test Alpha."
  }
  "dev-test-beta" = {
    display_name    = "Dev Test Beta"
    entra_tenant_id = "cccccccc-cccc-cccc-cccc-cccccccccccc"
    admin_group_id  = "dddddddd-dddd-dddd-dddd-dddddddddddd"
    agent_instruction = "You are a test agent for Dev Test Beta."
  }
}

default_tenant_id = "dev-test-alpha"

# -----------------------------------------------------------------------------
# BRANDING (Dev)
# -----------------------------------------------------------------------------
msp_default_branding = {
  company_name   = "Your MSP (Dev)"
  logo_url       = ""
  primary_color  = "#ff6b6b"  # Red to visually distinguish dev
  support_email  = "dev-support@yourmsp.com"
  support_phone  = "+1-555-0001"
}
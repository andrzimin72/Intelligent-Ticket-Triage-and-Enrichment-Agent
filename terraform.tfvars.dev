# =============================================================================
# MSP AI Platform - Development Environment
# =============================================================================

project     = "msp-triage"
environment = "dev"
aws_region  = "us-east-1"

# Microsoft Integration (Use a dedicated Dev Entra ID / App Registration)
entra_tenant_id      = "11111111-1111-1111-1111-111111111111"
entra_app_client_id  = "22222222-2222-2222-2222-222222222222"
agent_admin_group_id = "33333333-3333-3333-3333-333333333333"
bot_app_id           = "44444444-4444-4444-4444-444444444444"

# Communication (Use verified SES sandbox emails or internal dev lists)
alert_email                         = "dev-alerts@yourmsp.com"
password_reset_sender_email         = "dev-passwords@yourmsp.com"
password_reset_domain_name          = "" # Use default AWS URL in dev
portal_domain_name                  = "" # Use default AWS URL in dev

# Feature Flags (Enable all for comprehensive local testing)
enable_knowledge_base         = true
enable_tenant_portal          = true
enable_advanced_analytics     = true
enable_custom_health_checks   = true
enable_webhook_notifications  = true
enable_guardrails             = true
enable_xray_tracing           = true

# Relaxed Security & Retention for Dev
secret_recovery_window_days       = 0    # Immediate deletion for easy cleanup
log_retention_days                = 14
agent_audit_log_retention_days    = 30
metrics_retention_days            = 7
feedback_retention_days           = 30
status_history_retention_days     = 30
analytics_retention_days          = 30

# Relaxed Rate Limits for Testing
agent_self_rate_limits = {
  per_operation_hourly = 10
  per_operation_daily  = 50
  requests_hourly      = 50
}
agent_admin_rate_limits = {
  per_operation_hourly = 50
  per_operation_daily  = 200
  per_target_daily     = 10
  requests_hourly      = 100
}

# Shorter TTLs for faster test cycles
password_reset_token_ttl_seconds = 3600 # 1 hour
agent_confirmation_ttl_seconds   = 300  # 5 minutes
deprovision_drain_seconds        = 10   # Fast teardown
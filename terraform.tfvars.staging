# =============================================================================
# MSP AI Platform - Staging Environment
# =============================================================================

project     = "msp-triage"
environment = "staging"
aws_region  = "us-east-1"

# Microsoft Integration (Dedicated Staging App Registrations)
entra_tenant_id      = "55555555-5555-5555-5555-555555555555"
entra_app_client_id  = "66666666-6666-6666-6666-666666666666"
agent_admin_group_id = "77777777-7777-7777-7777-777777777777"
bot_app_id           = "88888888-8888-8888-8888-888888888888"

# Communication (Staging-specific)
alert_email                         = "staging-alerts@yourmsp.com"
password_reset_sender_email         = "staging-passwords@yourmsp.com"
password_reset_domain_name          = "reset-staging.yourmsp.com"
password_reset_hosted_zone_id       = "Z1234567890ABCDEF" # Replace with actual Route53 Zone ID
portal_domain_name                  = "portal-staging.yourmsp.com"
portal_hosted_zone_id               = "Z1234567890ABCDEF" # Replace with actual Route53 Zone6
portal_callback_url                 = "https://portal-staging.yourmsp.com/callback"
portal_logout_url                   = "https://portal-staging.yourmsp.com"

# Feature Flags (Mirror Production)
enable_knowledge_base         = true
enable_tenant_portal          = true
enable_advanced_analytics     = true
enable_custom_health_checks   = true
enable_webhook_notifications  = true
enable_guardrails             = true
enable_xray_tracing           = true

# Production-Like Retention (Slightly reduced for cost, but realistic)
secret_recovery_window_days       = 7
log_retention_days                = 90
agent_audit_log_retention_days    = 180
metrics_retention_days            = 90
feedback_retention_days           = 180
status_history_retention_days     = 90
analytics_retention_days          = 180

# Production-Like Limits
password_reset_token_ttl_seconds = 900  # 15 minutes
agent_confirmation_ttl_seconds   = 600  # 10 minutes
deprovision_drain_seconds        = 60   # 1 minute
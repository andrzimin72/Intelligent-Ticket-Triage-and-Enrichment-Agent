# =============================================================================
# MSP AI Platform - Production Environment
# =============================================================================
# WARNING: Changes here require formal change management and 2-person approval.
# =============================================================================

project     = "msp-triage"
environment = "prod"
aws_region  = "us-east-1"

# Microsoft Integration (Production App Registrations)
entra_tenant_id      = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
entra_app_client_id  = "bbbbbbbb-cccc-dddd-eeee-ffffffffffff"
agent_admin_group_id = "cccccccc-dddd-eeee-ffff-000000000000"
bot_app_id           = "dddddddd-eeee-ffff-0000-111111111111"

# Communication (Production Verified SES Domains)
alert_email                         = "alerts@yourmsp.com"
password_reset_sender_email         = "passwords@yourmsp.com"
password_reset_domain_name          = "reset.yourmsp.com"
password_reset_hosted_zone_id       = "ZABCDEF1234567890" # Replace with actual Route53 Zone ID
portal_domain_name                  = "portal.yourmsp.com"
portal_hosted_zone_id               = "ZABCDEF1234567890" # Replace with actual Route53 Zone ID
portal_callback_url                 = "https://portal.yourmsp.com/callback"
portal_logout_url                   = "https://portal.yourmsp.com"

# Feature Flags (All Enabled for Full Platform Capability)
enable_knowledge_base         = true
enable_tenant_portal          = true
enable_advanced_analytics     = true
enable_custom_health_checks   = true
enable_webhook_notifications  = true
enable_guardrails             = true
enable_xray_tracing           = true

# Strict Security & Maximum Compliance Retention
secret_recovery_window_days       = 30   # 30-day recovery window for safety
log_retention_days                = 365
agent_audit_log_retention_days    = 365  # 1 year for compliance
metrics_retention_days            = 90
feedback_retention_days           = 365
status_history_retention_days     = 90
analytics_retention_days          = 365

# Strict Production Limits
password_reset_token_ttl_seconds = 900  # 15 minutes (strict)
agent_confirmation_ttl_seconds   = 600  # 10 minutes
deprovision_drain_seconds        = 60   # 1 minute to prevent orphaned jobs

# Strict Rate Limits (Prevent runaway costs/abuse)
agent_self_rate_limits = {
  per_operation_hourly = 3
  per_operation_daily  = 5
  requests_hourly      = 10
}
agent_admin_rate_limits = {
  per_operation_hourly = 20
  per_operation_daily  = 50
  per_target_daily     = 3
  requests_hourly      = 30
}

# Cost Optimization (Aggressive in Prod)
simple_ticket_confidence_threshold = 0.75 # Route more tickets to cheaper Haiku model
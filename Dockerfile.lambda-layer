# =============================================================================
# Lambda Layer Builder
# =============================================================================
# Builds Lambda layers with native dependencies (cryptography, etc.)
# Ensures compatibility with AWS Lambda runtime (Amazon Linux 2)
# =============================================================================

FROM public.ecr.aws/lambda/python:3.13

# Install system dependencies for cryptography
RUN dnf install -y \
    gcc \
    gcc-c++ \
    openssl-devel \
    libffi-devel \
    rust \
    cargo \
    && dnf clean all

WORKDIR /build

# Copy requirements
COPY layers/bot-framework-jwt/requirements.txt /build/requirements.txt

# Install Python dependencies
# --platform ensures compatibility with Lambda runtime
# --target specifies where to install packages
RUN pip install --platform manylinux2014_x86_64 \
    --target=/build/package \
    --implementation cp \
    --python-version 3.13 \
    --only-binary=:all: \
    --upgrade \
    --requirement /build/requirements.txt

# Remove unnecessary files to reduce layer size
RUN find /build/package -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
RUN find /build/package -type f -name "*.pyc" -delete
RUN find /build/package -type f -name "*.pyo" -delete

# Create zip file
RUN cd /build/package && zip -r9 /build/layer.zip . \
    && echo "Layer size: $(du -h /build/layer.zip | cut -f1)"

# Default command (not used, just for documentation)
CMD ["echo", "Layer built successfully"]